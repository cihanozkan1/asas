{
  "name": "geo-shorts",
  "version": "0.1.0",
  "private": true,
  "description": "\"Why...?\" geography explainer YouTube Shorts pipeline: globe + map + narration + word-synced captions.",
  "type": "module",
  "scripts": {
    "setup": "node tools/fetch-data.mjs",
    "check": "node scripts/pipeline.mjs --check-only",
    "make": "node scripts/pipeline.mjs",
    "stills": "node scripts/pipeline.mjs --stills",
    "voices": "node tools/voices.mjs",
    "routes:check": "node tools/validate_routes.mjs",
    "geodata": "bash tools/fetch_geodata.sh",
    "vfx:emoji": "python3 tools/ingest_emoji.py",
    "vfx:remotion": "node tools/remotion_clip.mjs",
    "vfx:ingest": "python3 tools/vfx_ingest.py",
    "remotion:setup": "cd remotion && npm install && npx remotion browser ensure",
    "remotion:studio": "cd remotion && npx remotion studio src/index.ts --browser-executable=$PWD/chrome-wrapper.sh",
    "emoji:fetch": "bash tools/fetch_emoji.sh",
    "blender:setup": "bash tools/blender/setup.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@turf/turf": "^7.4.0",
    "@twemoji/svg": "^15.0.0",
    "d3-geo": "^3.1.1",
    "esbuild": "^0.28.2",
    "flag-icons": "^7.5.0",
    "https-proxy-agent": "^9.1.0",
    "i18n-iso-countries": "^7.14.0",
    "msedge-tts": "^2.0.8",
    "puppeteer-core": "^25.12.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
